<?xml version="1.0"?>
<package format="3">
  <name>wcr_teensy_bridge</name>
  <version>0.1.0</version>
  <description>Bidirectional ROS 2 serial bridge for Teensy thrusters and HX711 load cells.</description>

  <maintainer email="info@example.com">WCR</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>wcr_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
