<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wheel_smc_controller</name>
  <version>0.1.0</version>
  <description>
    MIMO sliding-mode controller for the four driving wheels of a 4WIS4WID
    mobile robot, based on Lee &amp; Li (2014). Operates as a ros2_control
    plugin: subscribes to wheel velocity references, reads wheel velocities
    and steering angles as state, writes torque commands.
  </description>
  <maintainer email="branimir@example.com">Branimir</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_gmock</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>